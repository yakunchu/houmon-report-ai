{
  "name": "houmon-report-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "gen:prompt": "tsx scripts/gen-prompt.ts",
    "predev": "npm run gen:prompt",
    "prebuild": "npm run gen:prompt",
    "eval": "node --env-file=.env --import tsx scripts/eval.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cert:dev": "node scripts/make-dev-cert.mjs",
    "predev:https": "npm run gen:prompt",
    "dev:https": "next dev --experimental-https --experimental-https-key certificates/dev-key.pem --experimental-https-cert certificates/dev-cert.pem --experimental-https-ca certificates/rootCA.pem",
    "serve:ca": "node scripts/serve-ca.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
