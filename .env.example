# コピーして .env を作り、値は手で書き込む（.env は git 管理外）
ANTHROPIC_API_KEY=

# 任意: 既定は claude-opus-5-5 / effort low（2026-11-04 の比較で、medium と同じ精度のまま所要が約半分）
# もっと速くしたいときは claude-sonnet-5-5（約 7〜8 秒。同じ台本で選択式 13/13）
# HOUMON_MODEL=claude-opus-5-5
# HOUMON_EFFORT=low

# 任意: 同じ Wi-Fi の端末どうしで患者リストを受け渡す「受け渡しコード」（/api/sync）。既定は off（HOUMON_SYNC=on と書いたときだけ有効）。
# 実名・生年月日・住所を含む患者リストを暗号化して、このアプリを動かしているサーバーのメモリに 10 分だけ預ける（ディスクには書かない）。
# 注意: 復号に使うコードもサーバーに送られるため、サーバーを動かす PC では中身を読める。AI には送らない。
# 使うのは、自分の薬局の PC が動かす LAN 内のサーバーだけ。Vercel などインターネットに公開する環境では on にしない。
# HOUMON_SYNC=on
